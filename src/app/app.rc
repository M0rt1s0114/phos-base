// The resource script: the tray menu, the string table, the two icons and the
// version block at the end. The strings are Simplified Chinese, so the file is
// written in GBK and says so to the resource compiler with the code page below --
// the same page the rest of this project's Chinese text is in.
#include "resource.h"
#include "identity.h"
#include <WinRes.h>

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(936)

/////////////////////////////////////////////////////////////////////////////
// Icons

IDI_Main                ICON                    "icons\\main.ico"
IDI_ICON1               ICON                    "icons\\tray.ico"
/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU1 MENU 
BEGIN
    POPUP "Phosphor_TrayPopupMenu"
    BEGIN
        MENUITEM "Phosphor帮助说明(&A)...", 21121
        MENUITEM SEPARATOR
        MENUITEM "分辨率1024X768 颜色32位 刷新率85", 21122
        MENUITEM "分辨率1024X768 颜色32位 刷新率90", 21123
        MENUITEM "分辨率1024X768 颜色16位 刷新率85", 21124
        MENUITEM "分辨率1024X768 颜色16位 刷新率90", 21125
        MENUITEM SEPARATOR
        MENUITEM "分辨率1280X1024 颜色32位 刷新率85", 21126
        MENUITEM "分辨率1280X1024 颜色32位 刷新率90", 21127
        MENUITEM "分辨率1280X1024 颜色16位 刷新率85", 21128
        MENUITEM "分辨率1280X1024 颜色16位 刷新率90", 21129
        MENUITEM SEPARATOR
        MENUITEM "分辨率800X600 颜色32位 刷新率85", 21130
        MENUITEM "分辨率800X600 颜色32位 刷新率75", 21131
        MENUITEM "分辨率800X600 颜色16位 刷新率85", 21132
        MENUITEM "分辨率800X600 颜色16位 刷新率75        Ctrl+Alt+A", 21133
        MENUITEM SEPARATOR
        MENUITEM "弹出所有的USB磁盘(&U)", 21134
        MENUITEM "弹出光驱中的光碟(&C)", 21135
        MENUITEM SEPARATOR
        MENUITEM "清理临时文件夹的文件(&D)...", 21136
        MENUITEM "重新设置临时文件目录(&S)...", 21137
        MENUITEM SEPARATOR
        MENUITEM "隐藏/显示托盘图标(&H)      Ctrl+Alt+M", 21138
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// String Table
//

STRINGTABLE 
BEGIN
    IDS_CmdErr              "执行错误："
    IDS_FoundDevice         "\r\n找到设备: %s"
    IDS_FoundDriver         "\r\n找到驱动: %s, INF 文件: %s"
    IDS_LogoErr             "可能因内存不足，加载 LOGO 出现错误，是否重新启动？\r\n选择[是]则重启，[否]则关机。"
    IDS_LogoErrTip          "发生错误！"
    IDS_TrayTip             "Phosphor - WinPE startup commander"
    IDS_BrowseTitle         "请选择目标目录或文件。"
    IDS_RETRY_EJECT         "无法弹出驱动器，是否重试？"
    IDS_EJECT_ERR           "弹出失败！"
    IDS_ReadEnviFail        "读取环境变量失败。"
    IDS_Error               "错误！"
    IDS_TempFolder          "临时文件夹位于 %s 目录，\r\n"
    IDS_ClearTemp           "现在是否要清理临时文件夹？"
    IDS_ClearTempFolder     "清理临时文件夹。"
    IDS_ReSetTempFolder     "是否重新设置临时文件夹的位置？"
    IDS_SetTempFolder       "设置临时文件夹。"
END

STRINGTABLE 
BEGIN
    IDS_NewTempFolder       "选择新的临时文件夹。"
    IDS_SaveToClipboard     "结果已保存到粘帖板。"
    IDS_MD5String           "字符串MD5："
END

// The version block and the common-controls manifest live in their own file,
// which is what lets the resource editor regenerate them without touching the
// menu above.
#include "version.rc2"