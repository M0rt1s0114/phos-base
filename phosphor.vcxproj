    <PlatformToolset>v142</PlatformToolset>
    <UseOfMfc>false</UseOfMfc>
    <UseOfAtl>false</UseOfAtl>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v142</PlatformToolset>
    <UseOfMfc>false</UseOfMfc>
    <UseOfAtl>false</UseOfAtl>
    <CharacterSet>Unicode</CharacterSet>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(ProjectDir)build\$(Platform)\</OutDir>
    <IntDir>$(ProjectDir)build\obj\$(Platform)\</IntDir>
    <!-- The product is phos.exe. -->
    <TargetName>phos</TargetName>
    <LinkIncremental>false</LinkIncremental>
    <GenerateManifest>false</GenerateManifest>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>Default</InlineFunctionExpansion>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <EnableFiberSafeOptimizations>false</EnableFiberSafeOptimizations>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- Static CRT on purpose: WinPE has no vcruntime140 / UCRT. -->
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <!-- /EHsc: the Phosphor front end uses exceptions for its non local exits
           (uncaught error, return). Without it MSVC warns C4530 and does not
           unwind, which would turn a script error into a crashed boot. -->
      <ExceptionHandling>Sync</ExceptionHandling>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <!-- /GS on. It was off in the first release, which is why a family of
           overruns in the command parser showed up as mysterious behaviour
           instead of crashing where they happened. -->
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <!-- C4100 is the unreferenced-parameter note, and the text handlers keep
           their fixed (ctx, command) signature whether they use both or not;
           C4706 is the deliberate "while ((p = find(...)))" idiom. Everything
           else /W4 says is worth reading. -->
      <DisableSpecificWarnings>4100;4706;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <!-- /sdl: the extra compile-time and run-time checks that come with /GS.
           Nothing in this tree needs the looser defaults. -->
      <SDLCheck>true</SDLCheck>
      <EnablePREfast>true</EnablePREfast>
      <!-- The analyser's four standing notes, each read once and accepted:
           C6054 the buffer is terminated by StringCchVPrintf inside the
                 UStrPrint wrapper, which the analyser does not see through;
           C28159 GetTickCount is deliberate: a boot chain does not run for the
                 49 days it takes the 32-bit counter to wrap;
           C28251 the entry point is spelled with the classic _tWinMain shape;
           C6335 the two process handles are closed by the guard in Exec(). -->
      <DisableSpecificWarnings>4100;4706;6054;28159;28251;6335;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <RegisterOutput>false</RegisterOutput>
      <SubSystem>Windows</SubSystem>
      <TargetMachine>MachineX86</TargetMachine>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <SetChecksum>false</SetChecksum>
      <!-- Off on purpose: /DEBUG:FULL puts the build machine's source path into
           the RSDS record, so a shipped binary carries a piece of the build
           machine's workspace with it. The crash record is text on the trace
           channel, so nothing here needs a PDB. -->
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <InlineFunctionExpansion>Default</InlineFunctionExpansion>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <EnableFiberSafeOptimizations>false</EnableFiberSafeOptimizations>
      <PreprocessorDefinitions>WIN32;NDEBUG;_WINDOWS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <ExceptionHandling>Sync</ExceptionHandling>
      <BasicRuntimeChecks>Default</BasicRuntimeChecks>
      <BufferSecurityCheck>true</BufferSecurityCheck>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <DisableSpecificWarnings>4100;4706;6054;28159;28251;6335;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <SDLCheck>true</SDLCheck>
      <EnablePREfast>true</EnablePREfast>
      <AdditionalIncludeDirectories>$(ProjectDir)src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <RegisterOutput>false</RegisterOutput>
      <SubSystem>Windows</SubSystem>
      <TargetMachine>MachineX64</TargetMachine>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <SetChecksum>false</SetChecksum>
      <GenerateDebugInformation>false</GenerateDebugInformation>
    </Link>
    <!-- The resource compiler is not the C++ compiler and does not define
         _M_X64, so identity.h took the x86 branch and the x64 binary shipped a
         version resource saying "X86U" and a manifest claiming
         processorArchitecture='x86'. Say it here. -->
    <ResourceCompile>
      <PreprocessorDefinitions>_M_X64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
